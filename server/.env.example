MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_16_digit_gmail_app_password

DB_HOST=localhost
DB_NAME=ptw_database
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Optional. Where generated content (MIWI docs, logs, on-demand DB backups, PTW/IC attachment
# folders) is stored - never beside the code. Defaults to an OS-appropriate per-machine
# directory if unset (~/.local/share/ptw-server on Linux, %LOCALAPPDATA%\PTW\server on
# Windows - see paths.py). Only set this to point it somewhere else, e.g. a larger/dedicated disk.
PTW_DATA_DIR=/path/to/data
