# Credentials — NEVER commit these
server/.env
client/.env

# Generated TLS private key + cert (server/deploy/generate_cert.sh) and the local-dev
# copy of the public cert (see requestConfig.py's PTW_CA_CERT_PATH fallback) — both are
# per-deployment material, not something to ship in the repo.
server/certs/
client/certs/
# Machine-specific nginx config with this box's absolute cert paths baked in — ptw.conf
# is the generic, committed template.
server/deploy/ptw.local.conf

# Python cache
__pycache__/
*.pyc
*.pyo

# Pyinstalller - Nuitka
*dist/
*build/
*.spec
client/pyinstaller*
client/nuitka*
*.bin

# Root-level duplicate/stale files (the real copies are in client/ and server/)
/PTW.py
/User.py

# Operational data — as of the DATA_DIR migration (see server/paths.py) this lives outside
# the repo by default; these rules are a safety net for the pre-migration layout and for
# PTW_DATA_DIR ever being pointed back under server/.
server/miwi/
server/ptw-*-attachments/
server/ic-*-attachments/
server/backups/
test_data

# Server logs
server/logs/

# Generated files
client/qr-summery-*.png

# IDE
.vscode/
*.swp

# One-off dev/maintenance scripts, local only — not for the repo
# (server/dev-scripts/ is a separate, tracked folder for scripts meant to ship with the repo)
/dev-scripts/
