# Optional. Copy to client/.env (or set these as real OS environment variables -
# either works, see requestConfig.py) to point this client at a real server instead of
# the http://localhost:5000 dev default. See "HTTPS Deployment" in README.md.

# The server's reverse-proxy URL, e.g. https://192.168.1.50 - see KNOWN_ISSUES.md H2.
PTW_SERVER_URL=https://your-server-address

# Path to the server's public self-signed cert (server/deploy/generate_cert.sh's
# server_cert.pem - the script also copies it to certs/dev-server-cert.pem here for
# local dev). Used as `requests`' verify= value - a pinned-cert check, not a "skip
# verification" flag. A relative value (recommended, shown below) resolves against this
# client's own install directory, not the process's working directory, so it stays
# portable across machines instead of baking in one machine's absolute path; an
# absolute path also works if you'd rather point at a cert kept somewhere else.
PTW_CA_CERT_PATH=certs/dev-server-cert.pem
